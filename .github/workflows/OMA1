name: CI

on:                        # Disparadores: Pushes y PRs a la rama main
  push:
    branches: [main]
  pull_request:
    branches: [main]

jobs:
  # Reto 2: Job de lint y formato que corre ANTES de las pruebas
  lint:
    name: Lint y formato (Ruff)
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - name: Instalar Ruff
        run: pip install ruff==0.15.11
      - name: Reglas de estilo y errores comunes
        run: ruff check .
      - name: Formato del codigo
        run: ruff format --check .

  # Reto 1 y Reto 3: Pruebas en Python 3.12 y 3.13 con cobertura mínima del 80%
  pruebas:
    name: Pruebas (Python ${{ matrix.python-version }})
    runs-on: ubuntu-latest
    needs: lint                            # Garantiza que este job corra DESPUÉS del lint
    strategy:
      matrix:
        python-version: ["3.12", "3.13"]    # Ejecuta en paralelo para 3.12 y 3.13
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: ${{ matrix.python-version }}
          cache: pip
          cache-dependency-path: requirements-dev.txt
      - name: Instalar dependencias
        run: pip install -r requirements-dev.txt
      - name: Ejecutar pruebas con cobertura minima del 80%
        run: pytest --cov=. --cov-fail-under=80 -v

  # Reto 4: Job de Quality Gate del Modelo
  quality-gate:
    name: Quality Gate del Modelo
    runs-on: ubuntu-latest
    needs: pruebas                         # Depende de que las pruebas pasen con éxito
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
          cache: pip
          cache-dependency-path: requirements-dev.txt
      - name: Instalar dependencias
        run: pip install -r requirements-dev.txt
      - name: Validar Quality Gate del modelo
        run: python scripts/quality_gate.py  # Ajusta el comando/script según tu proyecto
